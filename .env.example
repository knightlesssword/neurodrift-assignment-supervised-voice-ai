# Copy to .env and fill real values. Never commit .env.
# LiveKit self-hosted (Part A)
LIVEKIT_URL=ws://localhost:7880
# Browser-facing URL handed out in API responses. Only differs from LIVEKIT_URL
# inside docker compose (internal ws://livekit:7880 vs host-mapped address).
PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-0123456789abcdef-LOCALONLY
# Backend
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
# Agent worker
DEEPGRAM_API_KEY=
# Ollama local LLM (no key needed). Sole LLM for voice + judge (no OpenRouter code).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Compliance LLM: uses same Ollama local model (no key needed).
# If Ollama unavailable, compliance falls back to error state (never false pass).
